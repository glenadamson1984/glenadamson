import Component from '@glimmer/component';
import {tracked} from '@glimmer/tracking';
import {action} from '@ember/object';
import {on} from '@ember/modifier';
import {fn} from '@ember/helper';
import {pageTitle} from 'ember-page-title';
import {freshDay,stylists,services,decorate,validateBooking,advanceStatus,STORAGE_KEY,validSavedDay} from '../lib/daybook.mjs';

export default class Daybook extends Component {
 @tracked appointments=freshDay(); @tracked filter='All'; @tracked search=''; @tracked message=''; @tracked error=''; @tracked bookingOpen=false; @tracked resetOpen=false; @tracked client=''; @tracked stylist='Ava'; @tracked service='cut'; @tracked time='14:00';
 services=services;
 constructor(){super(...arguments);try{const saved=window.localStorage.getItem(STORAGE_KEY);if(saved){const parsed=JSON.parse(saved);if(validSavedDay(parsed))this.appointments=parsed;else this.message='Saved demo data could not be read. The sample day is shown.';}}catch{this.message='Browser storage is unavailable. You can still explore; changes last until you reload.';}}
 get filters(){return ['All',...stylists].map(name=>({name,selected:this.filter===name}));}
 get columns(){return stylists.filter(name=>this.filter==='All'||name===this.filter).map(name=>({name,initial:name[0],appointments:this.appointments.filter(a=>a.stylist===name&&`${a.client} ${services.find(s=>s.id===a.service).name}`.toLowerCase().includes(this.search.toLowerCase())).sort((a,b)=>a.start-b.start).map(decorate)}));}
 get active(){return this.appointments.filter(a=>a.status!=='Cancelled');}
 get count(){return this.active.length;} get arrived(){return this.appointments.filter(a=>a.status==='Arrived'||a.status==='In service').length;} get completed(){return this.appointments.filter(a=>a.status==='Completed').length;} get value(){return this.active.reduce((sum,a)=>sum+services.find(s=>s.id===a.service).price,0);}
 persist(){try{window.localStorage.setItem(STORAGE_KEY,JSON.stringify(this.appointments));}catch{this.message+=' Changes are only held for this visit because storage is unavailable.';}}
 @action setFilter(name){this.filter=name;}
 @action setSearch(e){this.search=e.target.value;}
 @action field(name,e){this[name]=e.target.value;this.error='';}
 @action openBooking(){this.bookingOpen=true;this.error='';}
 @action closeBooking(){this.bookingOpen=false;this.error='';}
 @action advance(id){const a=this.appointments.find(a=>a.id===id),status=advanceStatus(a.status);this.appointments=this.appointments.map(a=>a.id===id?{...a,status}:a);this.message=`${a.client}: ${status.toLowerCase()}.`;this.persist();}
 @action cancel(id){const a=this.appointments.find(a=>a.id===id);if(!['Scheduled','Arrived'].includes(a.status))return;this.appointments=this.appointments.map(a=>a.id===id?{...a,status:'Cancelled'}:a);this.message=`${a.client}’s booking was cancelled. The slot is now available.`;this.persist();}
 @action book(e){e.preventDefault();const [h,m]=this.time.split(':').map(Number);const input={client:this.client.trim(),stylist:this.stylist,service:this.service,start:h*60+m};this.error=validateBooking(input,this.appointments);if(this.error)return;this.appointments=[...this.appointments,{...input,id:crypto.randomUUID(),status:'Scheduled'}];this.message=`Booked ${input.client} with ${input.stylist} at ${this.time}.`;this.client='';this.bookingOpen=false;this.filter='All';this.search='';this.persist();}
 @action askReset(){this.resetOpen=true;}
 @action keepChanges(){this.resetOpen=false;}
 @action reset(){this.appointments=freshDay();this.filter='All';this.search='';this.client='';this.stylist='Ava';this.service='cut';this.time='14:00';this.error='';this.bookingOpen=false;this.resetOpen=false;this.message='Demo reset. The original eight appointments are restored.';this.persist();}
 <template>
 {{pageTitle "Salon Daybook | Ember demo by Glen Adamson"}}
 <a class="skip" href="#daybook">Skip to appointments</a>
 <div class="demo-banner"><span>INDEPENDENT EMBER.JS PROTOTYPE · FICTIONAL CLIENTS · SAVED IN THIS BROWSER</span><a href="/portfolio">← Glen’s portfolio</a></div>
 <header class="app-header"><a href="/portfolio" class="app-brand"><span class="brand-symbol">s<span>·</span></span><span>SALON<span class="brand-light"> / DAYBOOK</span></span></a><div><span class="sample-label">SAMPLE SALON / TUESDAY</span><button type="button" class="quiet" {{on "click" this.askReset}}>Reset demo ↻</button></div></header>
 <main id="daybook"><section class="day-heading"><div><span class="eyebrow">A LITTLE CALM IN A BUSY DAY</span><h1>Today, beautifully organised<span>.</span></h1><p>Tuesday 17 November 2026 <span>09:00–18:00 · Demo scenario</span></p></div><button class="primary" type="button" {{on "click" this.openBooking}}>＋ New booking</button></section>
 <div class="metrics"><div><span>APPOINTMENTS</span><strong>{{this.count}}</strong><small>Excludes cancellations</small></div><div><span>IN THE SALON</span><strong>{{this.arrived}}</strong><small>Arrived or in service</small></div><div><span>COMPLETED</span><strong>{{this.completed}}</strong><small>Services finished</small></div><div><span>BOOKED VALUE</span><strong>£{{this.value}}</strong><small>Not payments collected</small></div></div>
 <p class="feedback" role="status" aria-live="polite">{{this.message}}</p>
 {{#if this.resetOpen}}<section class="reset-confirm" aria-labelledby="reset-title"><div><h2 id="reset-title">Restore the sample day?</h2><p>This clears your bookings and status changes in this demo only.</p></div><button type="button" class="primary" {{on "click" this.reset}}>Reset to sample day</button><button type="button" {{on "click" this.keepChanges}}>Keep changes</button></section>{{/if}}
 {{#if this.bookingOpen}}<section class="booking-panel" aria-labelledby="booking-title"><div class="panel-heading"><h2 id="booking-title">A new appointment</h2><button type="button" {{on "click" this.closeBooking}}>Close</button></div><form {{on "submit" this.book}}><label>Client name<input required minlength="2" maxlength="60" value={{this.client}} {{on "input" (fn this.field "client")}} autocomplete="off" placeholder="Use a fictional name"/></label><label>Stylist<select value={{this.stylist}} {{on "change" (fn this.field "stylist")}}><option>Ava</option><option>Maya</option><option>Leo</option></select></label><label>Service<select value={{this.service}} {{on "change" (fn this.field "service")}}>{{#each this.services as |service|}}<option value={{service.id}}>{{service.name}} · {{service.duration}} min · £{{service.price}}</option>{{/each}}</select></label><label>Start time<input type="time" step="900" min="09:00" max="17:30" required value={{this.time}} {{on "input" (fn this.field "time")}}/></label><button type="submit" class="primary">Save booking</button></form>{{#if this.error}}<p class="error" role="alert">{{this.error}}</p>{{/if}}<p class="form-note">Clashes are checked for the full service duration, including appointments already in service.</p></section>{{/if}}
 <section class="board-section" aria-label="Appointment board"><div class="board-toolbar"><div class="staff-filters" aria-label="Filter by stylist">{{#each this.filters as |filter|}}<button type="button" aria-pressed={{filter.selected}} {{on "click" (fn this.setFilter filter.name)}}>{{filter.name}}</button>{{/each}}</div><label class="search-label"><span>Find an appointment</span><input type="search" value={{this.search}} placeholder="Client or service…" {{on "input" this.setSearch}}/></label></div><div class="staff-board">{{#each this.columns as |column|}}<section class="staff-column" aria-label={{column.name}}><header><span class="avatar">{{column.initial}}</span><div><h2>{{column.name}}</h2><p>Stylist</p></div><span class="column-count">{{column.appointments.length}} bookings</span></header><div class="appointment-list">{{#each column.appointments key="id" as |appointment|}}<article class="appointment {{appointment.statusClass}}"><div class="appointment-top"><span class="appointment-time">{{appointment.time}} <small>– {{appointment.end}}</small></span><span class="status">{{appointment.status}}</span></div><h3>{{appointment.client}}</h3><p>{{appointment.serviceName}}</p><div class="service-meta"><span>{{appointment.duration}} min</span><span>£{{appointment.price}}</span></div><div class="appointment-actions">{{#if appointment.nextLabel}}<button type="button" {{on "click" (fn this.advance appointment.id)}}>{{appointment.nextLabel}} →</button>{{/if}}{{#if appointment.canCancel}}<button type="button" class="cancel" {{on "click" (fn this.cancel appointment.id)}}>Cancel</button>{{/if}}</div></article>{{else}}<div class="empty-column">No matching appointments.</div>{{/each}}</div></section>{{/each}}</div></section>
 <footer class="demo-footer"><p>Built by <a href="/about">Glen Adamson</a> in Ember.js. Independent portfolio work, not Phorest software.</p><p>Explore safely with fictional names. <button type="button" {{on "click" this.askReset}}>Reset the scenario</button></p></footer></main>
 </template>
}
